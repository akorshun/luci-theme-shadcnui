{#
 luci-theme-shadcnui — header.ut
 Modeled after themes/luci-theme-bootstrap header. Server side renders only the
 minimal page chrome: <html> with theme-config-derived data-* attrs and inline
 CSS variables, <head> with our stylesheet, and an empty sidebar/topbar
 skeleton. The real menu tree is rendered on the client by menu-shadcnui.js.
-#}

{%
	const boardinfo = ubus.call('system', 'board');

	let mode      = uci.get('shadcnui', 'main', 'mode')   ?? 'system';
	let base      = uci.get('shadcnui', 'main', 'base')   ?? 'zinc';
	let accent    = uci.get('shadcnui', 'main', 'accent') ?? '';
	let bg_url    = uci.get('shadcnui', 'main', 'bg_url') ?? '';
	let radius    = uci.get('shadcnui', 'main', 'radius') ?? '0.5rem';

	/* Server-side default theme; client-side theme.js will refine 'system' to
	   match prefers-color-scheme without a flash. */
	let resolved = (mode == 'dark') ? 'dark' : 'light';

	let style_overrides = '';
	if (accent)
		style_overrides += `--primary:${accent};--ring:${accent};`;
	if (radius != '0.5rem')
		style_overrides += `--radius:${radius};`;
	if (bg_url)
		style_overrides += `--login-bg:url('${replace(bg_url, "'", "\\'")}');`;

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}"
      data-base="{{ base }}"
      data-mode="{{ mode }}"
      data-theme="{{ resolved }}"
      style="{{ style_overrides }}">
<head>
	<meta charset="utf-8">
	<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>

	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="color-scheme" content="light dark">
	<meta name="darkreader-lock">

	<link rel="stylesheet" href="{{ media }}/css/shadcnui.css">
	<link rel="icon" type="image/svg+xml" href="{{ media }}/icons/favicon.svg">

	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style type="text/css">{{ css }}</style>
	{% endif %}

	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
	<script src="{{ media }}/js/theme.js" defer></script>
	<script src="{{ media }}/js/sidebar.js" defer></script>
</head>

<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}"
      data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

{% if (!blank_page): %}
<div id="shadcn-app" data-sidebar="expanded">

	<aside id="shadcn-sidebar" aria-label="Main navigation">
		<div class="sidebar-header">
			<a class="brand" href="/">
				<div class="logo" aria-hidden="true">{{ substr(uc(boardinfo.hostname ?? 'OW'), 0, 2) }}</div>
				<span>{{ striptags(boardinfo.hostname ?? 'OpenWrt') }}</span>
			</a>
		</div>
		<nav class="sidebar-nav" id="shadcn-mainmenu" role="navigation"></nav>
		<div class="sidebar-footer" id="shadcn-modemenu"></div>
	</aside>

	<div id="shadcn-overlay" class="darkMask"></div>

	<header id="shadcn-topbar">
		<button class="topbar-toggle showSide" id="shadcn-sidebar-toggle"
		        type="button" aria-label="Toggle sidebar">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
			     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="3" y1="6"  x2="21" y2="6"/>
				<line x1="3" y1="12" x2="21" y2="12"/>
				<line x1="3" y1="18" x2="21" y2="18"/>
			</svg>
		</button>
		<div class="topbar-breadcrumb" id="shadcn-breadcrumb"></div>
		<div id="indicators" class="topbar-actions"></div>
	</header>

	<main id="shadcn-main">

		{% if (boardinfo.rootfs_type == 'initramfs'): %}
		<div class="alert-message warning">
			<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
			<p>{{ _('No changes to settings will be stored and are lost after rebooting.') }}</p>
			{% if (dispatcher.lookup('admin/system/flash')): %}
			<a class="btn" href="{{ dispatcher.build_url('admin/system/flash') }}">{{ _('Go to firmware upgrade...') }}</a>
			{% endif %}
		</div>
		{% endif %}

		<noscript>
			<div class="alert-message warning">
				<h4>{{ _('JavaScript required!') }}</h4>
				<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
			</div>
		</noscript>

		<div id="tabmenu" class="cbi-tabmenu" style="display:none"></div>
{% endif %}

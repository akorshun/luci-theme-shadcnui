{%
/*
 * luci-theme-shadcnui — sysauth.ut (login page)
 *
 * The runtime sets `duser` (default user), `fuser` (failed user), and exposes
 * `request.token` etc. We render a centered card on top of the configured
 * background image; mode/base/accent are inherited from header.ut.
 */
%}
<div class="sysauth-card">
  <h2>{{ striptags(boardinfo.hostname || 'OpenWrt') }}</h2>
  <p class="muted">{{ lang('Please sign in to manage this device.') }}</p>

  {% if (fuser): %}
    <div class="alert-message error">
      {{ lang('Invalid username and/or password! Please try again.') }}
    </div>
  {% endif %}

  <form method="post" action="{{ dispatcher.build_url(['admin']) }}">
    <input type="hidden" name="luci_username" value="" autocomplete="username" hidden />

    <div class="cbi-value">
      <label for="luci_username_v">{{ lang('Username') }}</label>
      <input type="text" id="luci_username_v" name="luci_username"
             value="{{ duser || 'root' }}" autocomplete="username" autofocus />
    </div>

    <div class="cbi-value">
      <label for="luci_password_v">{{ lang('Password') }}</label>
      <input type="password" id="luci_password_v" name="luci_password"
             autocomplete="current-password" />
    </div>

    <div class="cbi-page-actions">
      <button class="btn" type="submit">{{ lang('Login') }}</button>
    </div>
  </form>
</div>
